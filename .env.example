# Copiez ce fichier en .env et remplissez les valeurs. Ne jamais committer .env.
# Le fichier .env est maintenant chargé automatiquement au démarrage (python app.py).
APP_SECRET_KEY=change-me-with-at-least-32-random-characters
APP_DB_PATH=./data/app.sqlite3
HOST=127.0.0.1
PORT=8000
ALLOW_ADMIN_SETUP=false

# GLPI REST API v1. URL SANS /apirest.php, joignable depuis la machine qui lance l'app.
GLPI_BASE_URL=http://192.168.1.20/glpi
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
# true = autoriser http:// vers un serveur interne/test (garder false en production, utiliser HTTPS)
GLPI_ALLOW_HTTP=true
# false = accepter un certificat HTTPS auto-signé (test seulement)
GLPI_VERIFY_TLS=true

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ID de l'entité GLPI parente sous laquelle les 7 entités de stock sont créées (0 = entité racine).
GLPI_PARENT_ENTITY_ID=0

# --- Production derrière un reverse proxy HTTPS (voir docs/Deploiement_FSS.md) ---
# APP_ENV=production : cookies "Secure" + en-tête HSTS (exige HTTPS)
APP_ENV=development
# true seulement si Apache/Nginx est sur la même machine : lit l'IP réelle et l'hôte transmis par le proxy
TRUST_PROXY=false
# Tentatives de connexion par minute et par IP (en plus de 6 par minute et par compte)
LOGIN_IP_LIMIT=30
